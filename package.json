{
  "name": "cargo-constellations",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --import tsx --test tests/rendered-html.test.mjs tests/nmea-ais.test.ts tests/gfw-voyage-probe.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "ingest": "tsx services/ais-ingest.ts",
    "data:lanes": "node scripts/generate-maritime-lanes.mjs",
    "data:intelligence": "node scripts/generate-intelligence-data.mjs",
    "data:update": "npm run data:lanes && npm run data:intelligence",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "drizzle-orm": "0.45.2",
    "mqtt": "^5.15.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.12",
    "world-atlas": "^2.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cheerio": "^1.2.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "geotiff": "^3.0.5",
    "globals": "16.4.0",
    "proj4": "^2.21.0",
    "react-server-dom-webpack": "19.2.6",
    "searoute-js": "^0.1.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "xlsx": "^0.18.5"
  },
  "type": "module"
}
