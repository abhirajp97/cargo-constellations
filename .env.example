# Free key from https://aisstream.io — used only by the local relay.
AISSTREAM_API_KEY=
GFW_API_TOKEN=
AIS_RELAY_PORT=8787
ALLOWED_ORIGINS=http://localhost:3000,https://cargo-constellations.sanoja2000.chatgpt.site

# Keep false while validating the pipeline. True subscribes to the entire globe.
AIS_FULL_GLOBE=false

# Credential-free Norwegian Coastal Administration stream. Disable only for local isolation.
KYSTVERKET_AIS_ENABLED=true
KYSTVERKET_AIS_HOST=153.44.253.27
KYSTVERKET_AIS_PORT=5631

# Browser-facing URL for the key-safe relay.
NEXT_PUBLIC_AIS_WEBSOCKET_URL=ws://localhost:8787
